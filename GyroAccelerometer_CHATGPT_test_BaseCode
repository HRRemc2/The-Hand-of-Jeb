#include <Wire.h>

const int MPU_ADDR = 0x68;

// raw data
int16_t ax, ay, az;
int16_t gx, gy, gz;
int16_t tempRaw;

// converted values
float ax_mps2, ay_mps2, az_mps2;
float gx_dps, gy_dps, gz_dps;
float tempC, tempF;

// crude velocity estimate (VERY noisy)
float vx = 0, vy = 0, vz = 0;
unsigned long lastTime;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(21, 22);
  Wire.setClock(100000);

  // wake MPU
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();

  lastTime = millis();

  Serial.println("MPU6050 READY");
}

void loop() {

  // time step
  float dt = (millis() - lastTime) / 1000.0;
  lastTime = millis();

  // read data
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, 14);

  ax = Wire.read() << 8 | Wire.read();
  ay = Wire.read() << 8 | Wire.read();
  az = Wire.read() << 8 | Wire.read();

  tempRaw = Wire.read() << 8 | Wire.read();

  gx = Wire.read() << 8 | Wire.read();
  gy = Wire.read() << 8 | Wire.read();
  gz = Wire.read() << 8 | Wire.read();

  // =========================
  // CONVERSIONS
  // =========================

  // acceleration (m/s²)
  ax_mps2 = ax / 16384.0 * 9.80665;
  ay_mps2 = ay / 16384.0 * 9.80665;
  az_mps2 = az / 16384.0 * 9.80665;

  // gyro (deg/s)
  gx_dps = gx / 131.0;
  gy_dps = gy / 131.0;
  gz_dps = gz / 131.0;

  // temperature
  tempC = (tempRaw / 340.0) + 36.53;
  tempF = (tempC * 9.0 / 5.0) + 32.0;

  // =========================
  // VERY BASIC VELOCITY ESTIMATE (NO FILTER)
  // =========================
  vx += ax_mps2 * dt;
  vy += ay_mps2 * dt;
  vz += az_mps2 * dt;

  // =========================
  // OUTPUT
  // =========================

  Serial.println("----- MPU6050 -----");

  Serial.print("Accel (m/s²): X=");
  Serial.print(ax_mps2);
  Serial.print(" Y=");
  Serial.print(ay_mps2);
  Serial.print(" Z=");
  Serial.println(az_mps2);

  Serial.print("Gyro (deg/s): X=");
  Serial.print(gx_dps);
  Serial.print(" Y=");
  Serial.print(gy_dps);
  Serial.print(" Z=");
  Serial.println(gz_dps);

  Serial.print("Velocity (m/s EST): X=");
  Serial.print(vx);
  Serial.print(" Y=");
  Serial.print(vy);
  Serial.print(" Z=");
  Serial.println(vz);

  Serial.print("Temp: ");
  Serial.print(tempC);
  Serial.print(" °C / ");
  Serial.print(tempF);
  Serial.println(" °F");

  Serial.println();

  delay(200);
}
