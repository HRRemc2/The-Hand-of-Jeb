#include <TinyGPS++.h>
#include <Wire.h>

TinyGPSPlus gps;

// Use UART1 on ESP32
HardwareSerial gpsSerial(1);

// GPS data variables
double latGPS = 0.0;
double lonGPS = 0.0;
double altGPS = 0.0;

void setup()
{
  Serial.begin(115200);

  Serial.println("GPS Setup");

  // baud, config, RX pin, TX pin
  // GPS TX -> GPIO16
  // GPS RX -> GPIO17
  gpsSerial.begin(9600, SERIAL_8N1, 16, 17);

  Serial.println("GPS Connected");
  Serial.println("Waiting For Connection");
}

void loop()
{
  GPS_loop(latGPS, lonGPS, altGPS);

  // Print data
  Serial.println("----- GPS DATA -----");

  Serial.print("Latitude: ");
  Serial.println(latGPS, 6);

  Serial.print("Longitude: ");
  Serial.println(lonGPS, 6);

  Serial.print("Altitude: ");
  Serial.print(altGPS);
  Serial.println(" m");

  Serial.println();

  delay(1000);
}

void GPS_loop(double &latGPS, double &lonGPS, double &altGPS)
{
  while (gpsSerial.available() > 0)
  {
    gps.encode(gpsSerial.read());
  }

  if (gps.location.isValid())
  {
    latGPS = gps.location.lat();
    lonGPS = gps.location.lng();

    altGPS = gps.altitude.meters();
  }
  else
  {
    latGPS = 1.11;
    lonGPS = 1.11;
    altGPS = 1.11;
  }
}
