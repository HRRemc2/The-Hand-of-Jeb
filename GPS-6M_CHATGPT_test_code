#include <TinyGPS++.h>
#include <SoftwareSerial.h>
#include <Wire.h>

const int MPU_ADDR = 0x68;

TinyGPSPlus gps;
//GPS RX:7 TX:8
SoftwareSerial gpsSerial(8,7);

//gps values
double latGPS = 0.0;
double lonGPS = 0.0;
int altGPS = 0;

//gyro values
int16_t ax, ay, az;
int16_t gx, gy, gz;
int16_t tempRaw;
//gyro converted values
float ax_mps2, ay_mps2, az_mps2;
float gx_dps, gy_dps, gz_dps;
float tempC, tempF;


void setup() {

  Serial.println("GPS Setup");

  Serial.begin(115200);
  gpsSerial.being(115200);

  Serial.println("GPS Connected");
  Serial.println("Finding Satelites");

  Serial.println("Gyro Setup");

  Wire.begin(21, 22);
  Wire.setClock(100000);

  Serial.println("Waking MPU");

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();

  Serial.println("Gyro Connected");

}

void loop() {
  
  GPS_loop(latGPS, lonGPS, altGPS);
  Gyro_loop(ax_mps2, ay_mps2, az_mps2, gx_dps, gy_dps, gz_dps, tempC, tempF);



}

void GPS_loop(double &latGPS, double &lonGPS, int &altGPS){
  while (gpsSerial.avaliable() > 0){
    gps.encode(gpsSerial.read());
  }
  if(gps.location.isValid()){
    latGPS = gps.location.lat();
    lonGPS = gps.location.lon();
    altGPS = gps.altitude.meters();
  }
  else{
    latGPS = 0.0;
    lonGPS = 0.0;
    altGPS = 0;
  }
}

void Gyro_loop(float &ax_mps2, float &ay_mps2, float &az_mps2, float &gx_dps, float &gy_dps, float &gz_dps, float &tempC, float &tempF){

  //read data
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, 14);

  ax = Wire.read() << 8 | Wire.read();
  ay = Wire.read() << 8 | Wire.read();
  az = Wire.read() << 8 | Wire.read();

  tempRaw = Wire.read() << 8 | Wire.read();

  gx = Wire.read() << 8 | Wire.read();
  gy = Wire.read() << 8 | Wire.read();
  gz = Wire.read() << 8 | Wire.read();

  //Conversions

  //acceleration
  ax_mps2 = ax / 16384.0 * 9.80665;
  ay_mps2 = ay / 16384.0 * 9.80665;
  az_mps2 = az / 16384.0 * 9.80665;

  //gyro
  gx_dps = gx / 131.0;
  gy_dps = gy / 131.0;
  gz_dps = gz / 131.0;

  //temp
  tempC = (tempRaw / 340.0) + 36.53;
  tempF = (tempC * 9.0 / 5.0) + 32.0;

}

























